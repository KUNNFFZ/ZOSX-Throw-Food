-- CYCLE loop : โยน N ครั้ง -> เทรน M วิ
task.spawn(function()
    while Hub.Running do
        if Hub.Flags.Cycle then
            pcall(function()
                local O = Hub.Opts
                local need = math.max(1, math.floor(O.CycleThrows or 5))
                if Hub.CyclePhase == "Throw" then
                    Hub.Flags.AutoTrain = false
                    if Hub.CycleThrown >= need then
                        Hub.Flags.AutoThrow = false
                        Hub.CyclePhase = "Train"
                        Hub.CycleTrainEnd = os.clock() + math.max(5, math.floor(O.CycleTrainSecs or 30))
                        Hub.Stats.CycleLast = string.format("โยนครบ %d -> ไปเทรน %d วิ", need, O.CycleTrainSecs)
                        if UI then UI:Notify({ Title = "Cycle", Text = string.format("โยนครบ %d ครั้ง → เทรน %d วิ", need, O.CycleTrainSecs), Duration = 4 }) end
                    else
                        Hub.Flags.AutoThrow = true
                    end
                else
                    Hub.Flags.AutoThrow = false
                    Hub.Flags.AutoTrain = true
                    if os.clock() >= (Hub.CycleTrainEnd or 0) then
                        Hub.Flags.AutoTrain = false
                        Hub.InTrain = false
                        pcall(function() Remotes.Invoke("Training_Stop") end)
                        Hub.CyclePhase = "Throw"
                        Hub.CycleThrown = 0
                        Hub.CycleDone = Hub.CycleDone + 1
                        local rounds = math.floor(O.CycleRounds or 0)
                        Hub.Stats.CycleLast = string.format("รอบที่ %d เสร็จ -> กลับไปโยน", Hub.CycleDone)
                        if UI then UI:Notify({ Title = "Cycle", Text = string.format("เทรนครบ %d วิ → กลับไปโยน %d ครั้ง (รอบที่ %d)", O.CycleTrainSecs, need, Hub.CycleDone), Duration = 4 }) end
                        if rounds > 0 and Hub.CycleDone >= rounds then
                            Hub.Flags.Cycle = false
                            Hub.Flags.AutoThrow = false
                            Hub.Stats.CycleLast = string.format("จบครบ %d รอบ", Hub.CycleDone)
                            if UI then UI:Notify({ Title = "Cycle เสร็จ", Text = string.format("ทำครบ %d รอบแล้ว หยุดอัตโนมัติ", Hub.CycleDone), Duration = 8 }) end
                        end
                    end
                end
                if UI and UI.SetStatus then
                    local s
                    if Hub.CyclePhase == "Throw" then
                        s = string.format("Cycle โยน %d/%d (รอบที่ %d)", Hub.CycleThrown, need, Hub.CycleDone + 1)
                    else
                        s = string.format("Cycle เทรน เหลือ %d วิ (รอบที่ %d)", math.max(0, math.floor((Hub.CycleTrainEnd or 0) - os.clock())), Hub.CycleDone + 1)
                    end
                    pcall(function() UI:SetStatus(s) end)
                end
            end)
        end
        task.wait(0.4)
    end
end)

task.spawn(function()
    while Hub.Running do
        if Hub.Flags.AutoTrain then
            pcall(function()
                local hrp = getHRP()
                if not hrp then
                    Hub.InTrain = false
                else
                    local s = getSpot()
                    local pos = s and s.Position or Hub.TrainPos
                    if not Hub.InTrain then
                        if (hrp.Position - pos).Magnitude > (Hub.Opts.DriftRadius or 8) then
                            warp(pos)
                            task.wait(0.3)
                        end
                        if os.clock() - (Hub.LastTry or 0) > 1.5 then
                            Hub.LastTry = os.clock()
                            local ok, r = pcall(function() return Remotes.Invoke("Training_Start") end)
                            if ok and type(r) == "table" then
                                if r.Ok or r.Reason == "Busy" then
                                    Hub.InTrain = true
                                    Hub.TrainAt = os.clock()
                                    Hub.Stats.TrainLast = r.Ok and "training started" or "training running"
                                elseif r.Reason == "Throwing" then
                                    pcall(function() Remotes.Invoke("Throw_Cancel") end)
                                    Hub.Stats.TrainLast = "cancel throw..."
                                else
                                    Hub.Stats.TrainLast = "start: " .. tostring(r.Reason)
                                end
                            end
                        end
                    else
                        if (hrp.Position - pos).Magnitude > (Hub.Opts.DriftRadius or 8) * 3 then
                            Hub.InTrain = false
                        elseif os.clock() - Hub.TrainAt > 25 then
                            Hub.InTrain = false
                        end
                    end
                end
            end)
        end
        task.wait(0.4)
    end
end)

task.spawn(function()
