-- SHOP loop
task.spawn(function()
    while Hub.Running do
        if Hub.Flags.AutoFood and FoodsConfig and type(FoodsConfig.List) == "table" then
            pcall(function()
                local m = money()
                local reserve = Hub.Opts.Reserve or 0
                local best = nil
                for _, f in ipairs(FoodsConfig.List) do
                    local p = tonumber(f.Price) or 0
                    if Balance and Balance.GetItemPrice then
                        local ok, v = pcall(Balance.GetItemPrice, LP, f)
                        if ok and tonumber(v) then p = tonumber(v) end
                    end
                    if m - reserve >= p then
                        if Hub.Opts.FoodMode == "ถูกสุดที่ไหว" then
                            if not best or p < best.Price then best = { Food = f, Price = p } end
                        else
                            if not best or p > best.Price then best = { Food = f, Price = p } end
                        end
                    end
                end
                if best then
                    local ok, r = pcall(function() return Remotes.Invoke("Shop_Buy", best.Food.Index) end)
                    if ok and type(r) == "table" and r.Ok then
                        Hub.Stats.Food = Hub.Stats.Food + 1
                        Hub.Stats.ShopLast = "ซื้ออาหาร " .. tostring(best.Food.Name) .. " (" .. fmtMoney(best.Price) .. ")"
                        if Hub.Opts.AutoEquipFood then
                            pcall(function() Remotes.Invoke("Shop_Equip", best.Food.Index) end)
                        end
                    else
                        Hub.Stats.ShopLast = "ซื้ออาหารไม่สำเร็จ: " .. enc(r)
                    end
                end
            end)
        end
        if Hub.Flags.AutoBar then
            pcall(function()
                local d = data()
                local cur = (d and tonumber(d.Stand)) or 1
                local nx = StandsConf and StandsConf.All[cur + 1]
                if nx and money() - (Hub.Opts.Reserve or 0) >= (tonumber(nx.Price) or math.huge) then
                    local ok, r = pcall(function() return Remotes.Invoke("Stand_Upgrade") end)
                    if ok and type(r) == "table" and r.Ok then
                        Hub.Stats.Bar = Hub.Stats.Bar + 1
                        Hub.Stats.ShopLast = "อัพบาร์ -> " .. tostring(nx.Name)
                    end
                end
            end)
        end
        if Hub.Flags.AutoPlot then
            pcall(function()
                local d = data()
                local cur = (d and tonumber(d.FenceLevel)) or 0
                local nu = FenceConfig and FenceConfig.Upgrades[cur + 1]
                if nu and money() - (Hub.Opts.Reserve or 0) >= (tonumber(nu.Price) or math.huge) then
                    local ok, r = pcall(function() return Remotes.Invoke("Plot_UpgradeFence") end)
                    if ok and type(r) == "table" and r.Ok then
                        Hub.Stats.Plot = Hub.Stats.Plot + 1
                        Hub.Stats.ShopLast = "อัพ Plot -> " .. tostring(nu.Slots) .. " ช่อง"
                    end
                end
            end)
        end
        task.wait(Hub.Opts.ShopDelay or 1.5)
    end
end)

