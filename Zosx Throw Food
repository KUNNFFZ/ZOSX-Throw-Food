function Hub.Stop()
    Hub.Running = false
    for k in pairs(Hub.Flags) do Hub.Flags[k] = false end
    pcall(function() Remotes.Invoke("Training_Stop") end)
    pcall(function() applyFpsBoost(false) end)
    pcall(function() applyFog(false) end)
    pcall(function() applyFullbright(false) end)
    pcall(function() applyWalk(false) end)
    pcall(function() applyJump(false) end)
    pcall(function() local cam = workspace.CurrentCamera; if cam then cam.FieldOfView = 70 end end)
    if ThrowMeter then
        ThrowMeter.TestAutoTap = nil
        if Hub.OrigRun then ThrowMeter.Run = Hub.OrigRun end
    end
    if Hub.OrigInvoke then Remotes.Invoke = Hub.OrigInvoke end
    for _, c in ipairs(Hub.Conns) do pcall(function() c:Disconnect() end) end
    Hub.Conns = {}
    pcall(function() UI:Destroy() end)
end

