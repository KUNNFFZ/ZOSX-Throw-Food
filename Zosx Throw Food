-- ================= Auto Equip Best =================
local function equipBest()
    local d = data()
    if not d then return "no data" end
    local slots = slotsCount()
    local list = animalsList()
    local placed, unplaced = {}, {}
    for _, a in ipairs(list) do
        if a.Placed then placed[#placed + 1] = a else unplaced[#unplaced + 1] = a end
    end
    local equips, swaps = 0, 0
    local free = slots - #placed
    local ui = 1
    while free > 0 and unplaced[ui] do
        local ok, r = pcall(function() return Remotes.Invoke("Plot_EquipAnimal", unplaced[ui].Id) end)
        if ok and type(r) == "table" and r.Ok then
            equips = equips + 1
            free = free - 1
            ui = ui + 1
        else
            break
        end
        task.wait(0.05)
    end
    table.sort(placed, function(x, y) return (x.Income or 0) < (y.Income or 0) end)
    for _, worst in ipairs(placed) do
        if not unplaced[ui] then break end
        if (unplaced[ui].Income or 0) > (worst.Income or 0) then
            local ok1, r1 = pcall(function() return Remotes.Invoke("Plot_PickUpAnimal", worst.Id) end)
            if ok1 and type(r1) == "table" and r1.Ok then
                local ok2, r2 = pcall(function() return Remotes.Invoke("Plot_EquipAnimal", unplaced[ui].Id) end)
                if ok2 and type(r2) == "table" and r2.Ok then
                    swaps = swaps + 1
                    ui = ui + 1
                else
                    pcall(function() Remotes.Invoke("Plot_EquipAnimal", worst.Id) end)
                    break
                end
            else
                break
            end
        else
            break
        end
        task.wait(0.05)
    end
    if equips + swaps > 0 then
        local after = 0
        for _, a in ipairs(animalsList()) do if a.Placed then after = after + (a.Income or 0) end end
        return string.format("equip %d, สลับ %d | รวม %s | %d/%d ช่อง", equips, swaps, fmtPS(after), math.min(#placed + equips, slots), slots)
    end
    return string.format("ดีสุดอยู่แล้ว | %d/%d ช่อง", #placed, slots)
end

-- ================= Auto Sell =================
local function collectSellTargets()
    local out = {}
    local maxIdx = rIdx(Hub.Opts.SellRarity) or 0
    for _, a in ipairs(animalsList()) do
        local keep = false
        if a.Placed and not Hub.Opts.SellPlaced then keep = true end
        if not keep and Hub.Opts.SellMode ~= "ขายทั้งหมด" then
            if (a.RIdx or 0) > maxIdx then keep = true end
        end
        if not keep then out[#out + 1] = a end
    end
    table.sort(out, function(x, y) return (x.Price or 0) < (y.Price or 0) end)
    return out
end

local function sellBatch(notify)
    local targets = collectSellTargets()
    if #targets == 0 then
        if notify and UI then UI:Notify({ Title = "Auto Sell", Text = "ไม่มีสัตว์ที่ตรงเงื่อนไข", Duration = 3 }) end
        return 0, 0
    end
    local count, gained = 0, 0
    for _, a in ipairs(targets) do
        if not Hub.Running then break end
        local ok, r = pcall(function() return Remotes.Invoke("Plot_SellAnimal", a.Id) end)
        if ok and type(r) == "table" and r.Ok then
            count = count + 1
            gained = gained + (tonumber(r.Money) or 0)
        end
        task.wait(Hub.Opts.SellStep or 0.15)
    end
    Hub.Stats.Sold = Hub.Stats.Sold + count
    Hub.Stats.SellMoney = Hub.Stats.SellMoney + gained
    if count > 0 then
        Hub.Stats.SellLast = string.format("ขาย %d ตัว ได้ %s", count, fmtMoney(gained))
        if UI then UI:Notify({ Title = "Auto Sell", Text = Hub.Stats.SellLast, Duration = 3 }) end
    end
    return count, gained
end

