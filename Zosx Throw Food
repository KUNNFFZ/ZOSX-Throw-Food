local origLight = { Saved = false, Atmosphere = {} }
local fpsRemoved = {}
local fpsSavedQuality = nil

local function saveLight()
    if origLight.Saved then return end
    origLight.Saved = true
    origLight.FogEnd = Lighting.FogEnd
    origLight.FogStart = Lighting.FogStart
    origLight.FogColor = Lighting.FogColor
    origLight.Brightness = Lighting.Brightness
    origLight.Ambient = Lighting.Ambient
    origLight.OutdoorAmbient = Lighting.OutdoorAmbient
    origLight.GlobalShadows = Lighting.GlobalShadows
    origLight.ClockTime = Lighting.ClockTime
    for _, a in ipairs(Lighting:GetChildren()) do
        if a:IsA("Atmosphere") then
            origLight.Atmosphere[a] = { Density = a.Density, Haze = a.Haze }
        end
    end
end

local function applyFog(on)
    saveLight()
    for _, a in ipairs(Lighting:GetChildren()) do
        if a:IsA("Atmosphere") then
            local o = origLight.Atmosphere[a]
            if on then
                a.Density = 0
                a.Haze = 0
            elseif o then
                a.Density = o.Density
                a.Haze = o.Haze
            end
        end
    end
    if on then
        Lighting.FogEnd = 1000000
        Lighting.FogStart = 1000000
        Lighting.FogColor = Color3.fromRGB(0, 0, 0)
    else
        Lighting.FogEnd = origLight.FogEnd
        Lighting.FogStart = origLight.FogStart
        Lighting.FogColor = origLight.FogColor
    end
end

local function applyFullbright(on)
    saveLight()
    if on then
        Lighting.Brightness = 3
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
        Lighting.GlobalShadows = false
        Lighting.ClockTime = 14
    else
        Lighting.Brightness = origLight.Brightness
        Lighting.Ambient = origLight.Ambient
        Lighting.OutdoorAmbient = origLight.OutdoorAmbient
        Lighting.GlobalShadows = origLight.GlobalShadows
        Lighting.ClockTime = origLight.ClockTime
    end
end

local EFFECT_CLASSES = {
    ParticleEmitter = true, Smoke = true, Fire = true, Sparkles = true,
    Trail = true, Beam = true, Explosion = true,
}

local function applyFpsBoost(on)
    if on then
        local n = 0
        for _, d in ipairs(workspace:GetDescendants()) do
            if EFFECT_CLASSES[d.ClassName] then
                local okE, en = pcall(function() return d.Enabled end)
                if okE and en then
                    pcall(function() d.Enabled = false end)
                    fpsRemoved[d] = true
                    n = n + 1
                end
            end
        end
        pcall(function()
            if not fpsSavedQuality then fpsSavedQuality = settings().Rendering.QualityLevel end
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function() Lighting.GlobalShadows = false end)
        Hub.Stats.MiscLast = "Boost FPS: ปิดเอฟเฟกต์ " .. n .. " จุด + คุณภาพต่ำสุด"
    else
        local n = 0
        for inst in pairs(fpsRemoved) do
            if inst and inst.Parent then pcall(function() inst.Enabled = true end); n = n + 1 end
        end
        fpsRemoved = {}
        pcall(function()
            if fpsSavedQuality then settings().Rendering.QualityLevel = fpsSavedQuality end
        end)
        Hub.Stats.MiscLast = "Boost FPS: คืนค่า " .. n .. " เอฟเฟกต์"
    end
end

