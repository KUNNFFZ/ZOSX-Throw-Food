-- MISC loop
task.spawn(function()
    while Hub.Running do
        pcall(function()
            local hum = getHum()
            if hum then
                if Hub.Flags.Speed and math.abs(hum.WalkSpeed - Hub.Opts.WalkSpeed) > 0.5 then
                    hum.WalkSpeed = Hub.Opts.WalkSpeed
                end
                if Hub.Flags.Jump then
                    if not hum.UseJumpPower then pcall(function() hum.UseJumpPower = true end) end
                    if math.abs(hum.JumpPower - Hub.Opts.JumpPower) > 0.5 then
                        hum.JumpPower = Hub.Opts.JumpPower
                    end
                end
            end
            if Hub.Flags.Fog and Lighting.FogEnd < 900000 then applyFog(true) end
            if Hub.Flags.Fullbright and (Lighting.Brightness < 2 or Lighting.GlobalShadows) then applyFullbright(true) end
            if Hub.Flags.Fov then
                local cam = workspace.CurrentCamera
                if cam and math.abs(cam.FieldOfView - Hub.Opts.Fov) > 0.5 then cam.FieldOfView = Hub.Opts.Fov end
            end
        end)
        task.wait(1)
    end
end)

