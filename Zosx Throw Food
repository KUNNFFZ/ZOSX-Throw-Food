local function warp(pos)
    local hrp = getHRP()
    if not hrp then return false end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    return true
end
local function animalsList()
    local d = data()
    local out = {}
    if not d or type(d.Animals) ~= "table" then return out end
    local best = bestIncome()
    for id, a in pairs(d.Animals) do
        local e = AE and AE.Get(a.ModelName) or nil
        local inc = 0
        if Mut then local ok, v = pcall(Mut.IncomeOf, a, best); if ok then inc = tonumber(v) or 0 end end
        local price = 0
        if Mut then local ok, v = pcall(Mut.SellPrice, a, best); if ok then price = tonumber(v) or 0 end end
        out[#out + 1] = {
            Id = id, Model = a.ModelName, Placed = (a.Placed and true or false),
            Mutation = a.Mutation, Income = inc, Price = price,
            Rarity = (e and e.Rarity) or nil, RIdx = rIdx(e and e.Rarity),
        }
    end
    table.sort(out, function(x, y) return (x.Income or 0) > (y.Income or 0) end)
    return out
end
local function syncKnown()
    local d = data()
    local new = {}
    if not d or type(d.Animals) ~= "table" then return new end
    for id, a in pairs(d.Animals) do
        if not Hub.Known[id] then
            Hub.Known[id] = true
            new[#new + 1] = { Id = id, Entry = a }
        end
    end
    return new
end
local function slotsCount()
    local d = data()
    local lvl = (d and tonumber(d.FenceLevel)) or 0
    if FenceConfig and FenceConfig.SlotsFor then
        local ok, s = pcall(FenceConfig.SlotsFor, lvl)
        if ok and tonumber(s) then return tonumber(s) end
    end
    return 14
end

