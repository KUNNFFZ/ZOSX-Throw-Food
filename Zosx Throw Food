local RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Divine", "Celestial", "Eternal", "Cosmic", "Supreme", "Sovereign" }

local function fmtMoney(n)
    if NF and NF.Money then local ok, s = pcall(NF.Money, n); if ok and s then return s end end
    return tostring(n)
end
local function fmtPS(n)
    if NF and NF.PerSecond then local ok, s = pcall(NF.PerSecond, n); if ok and s then return s end end
    return tostring(n)
end
local function data()
    if not DataCtrl then return nil end
    local ok, d = pcall(function() return DataCtrl.GetData() end)
    if ok and type(d) == "table" then return d end
    return nil
end
local function money()
    local d = data()
    return (d and tonumber(d.Money)) or 0
end
local function bestIncome()
    local ok, v = pcall(function() return LP:GetAttribute("BestIncome") end)
    return (ok and tonumber(v)) or 0
end
local function rIdx(name)
    if not name then return nil end
    if Rar and Rar.Get then
        local ok, r = pcall(Rar.Get, name)
        if ok and type(r) == "table" and r.Index then return tonumber(r.Index) end
    end
    for i, n in ipairs(RARITY_ORDER) do if n == name then return i end end
    return nil
end
local function getSpot()
    local lpp = workspace:FindFirstChild("LocalPlotProps")
    local ta = lpp and lpp:FindFirstChild("TrainingArea")
    return ta and ta:FindFirstChild("TrainingSpot")
end
local function getHRP()
