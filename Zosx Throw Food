-- ================= แจ้งสถานะอัตโนมัติทุกครั้งที่โยน =================
if type(Remotes.Invoke) == "function" then
    Hub.OrigInvoke = Remotes.Invoke
    Remotes.Invoke = function(name, ...)
        local a = table.pack(...)
        local r = table.pack(Hub.OrigInvoke(name, table.unpack(a, 1, a.n)))
        local res = r[1]
        pcall(function()
            if name == "Throw_Resolve" and type(res) == "table" then
                if res.Ok then
                    Hub.Stats.Throws = Hub.Stats.Throws + 1
                    if Hub.Flags.Cycle and Hub.CyclePhase == "Throw" then
                        Hub.CycleThrown = Hub.CycleThrown + 1
                    end
                    local best = bestIncome()
                    local newcomers = syncKnown()
                    local mut, inc = nil, nil
                    for _, n in ipairs(newcomers) do
                        local v = 0
                        if Mut then local okI, iv = pcall(Mut.IncomeOf, n.Entry, best); if okI then v = tonumber(iv) or 0 end end
                        if inc == nil or v > inc then inc = v; mut = n.Entry.Mutation end
                    end
                    if inc == nil then
                        local e = AE and AE.Get(res.ModelName)
                        inc = (e and tonumber(e.Income)) or 0
                    end
                    local txt = string.format("%s%s  |  %s studs  |  %s",
                        tostring(res.ModelName or "?"),
                        mut and (" [" .. tostring(mut) .. "]") or "",
                        string.format("%.0f", tonumber(res.Distance) or 0),
                        fmtPS(inc or 0))
                    Hub.Stats.Last = txt
                    UI:Notify({ Title = "Throw #" .. tostring(Hub.Stats.Throws), Text = txt, Duration = 3 })
                else
                    Hub.Stats.Fails = Hub.Stats.Fails + 1
                    Hub.Stats.Last = "FAIL: " .. tostring(res.Reason)
                    UI:Notify({ Title = "Throw พลาด", Text = tostring(res.Reason), Duration = 2 })
                end
            elseif name == "Throw_Start" and type(res) == "table" and not res.Ok then
                Hub.Stats.Fails = Hub.Stats.Fails + 1
                Hub.Stats.Last = "START FAIL: " .. tostring(res.Reason)
            end
        end)
        return table.unpack(r, 1, r.n)
    end
end

