local function toggle(parent, text, default, order, callback)
    local state = default
    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, LayoutOrder = order,
    }, parent)
    label(row, text, UDim2.new(1, -60, 1, 0))
    local glow = new("Frame", {
        Size = UDim2.fromOffset(52, 30), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 7, 0.5, 0), BackgroundColor3 = T.on,
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
    }, row)
    corner(glow, 15)
    local track = new("Frame", {
        Size = UDim2.fromOffset(38, 20), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = T.off,
        BorderSizePixel = 0, ZIndex = 2,
    }, row)
    corner(track, 10)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = T.dim,
        BorderSizePixel = 0, ZIndex = 3,
    }, track)
    corner(knob, 8)

    local function render(anim)
        local t = anim and 0.2 or 0
        tween(track, { BackgroundColor3 = state and T.on or T.off }, t)
        tween(knob, {
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
            BackgroundColor3 = state and T.bg or T.dim,
        }, t)
        tween(glow, { BackgroundTransparency = state and 0.86 or 1 }, t)
    end
    render(false)
    row.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if callback then callback(state) end
    end)
end

local function dropdown(parent, text, options, default, order, callback)
    local idx = table.find(options, default) or 1
    local row = new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = order }, parent)
    label(row, text, UDim2.new(1, -124, 1, 0), nil, T.text)
    local btn = new("TextButton", {
        Size = UDim2.new(0, 116, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = T.bg, BorderSizePixel = 0, AutoButtonColor = false,
        Text = options[idx] .. "  ▾", TextColor3 = T.text, TextSize = 12,
        Font = Enum.Font.GothamMedium, TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)
    corner(btn, 7); stroke(btn)
    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        btn.Text = options[idx] .. "  ▾"
        if callback then callback(options[idx]) end
    end)
    if callback then callback(options[idx]) end
end

local function slider(parent, text, min, max, default, order, callback)
    local function pct(v) return (v - min) / (max - min) end
    local row = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = order }, parent)
    label(row, text, UDim2.new(1, -50, 0, 14), nil, T.text)
    local val = label(row, tostring(default), UDim2.new(0, 46, 0, 14), UDim2.new(1, -46, 0, 0),
        T.dim, Enum.Font.Gotham, Enum.TextXAlignment.Right)
    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 22),
        BackgroundColor3 = T.off, BorderSizePixel = 0,
    }, row)
    corner(bar, 2)
    local fill = new("Frame", { Size = UDim2.fromScale(pct(default), 1), BackgroundColor3 = T.on, BorderSizePixel = 0 }, bar)
    corner(fill, 2)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(pct(default), 0.5), BackgroundColor3 = T.on, BorderSizePixel = 0,
    }, bar)
    corner(knob, 5)
    new("UIStroke", { Color = T.on, Transparency = 0.55, Thickness = 3 }, knob)
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 14),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, row)

    local dragging = false
    local function set(px)
        local rel = math.clamp((px - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.fromScale(rel, 1)
        knob.Position = UDim2.fromScale(rel, 0.5)
        val.Text = tostring(v)
        if callback then callback(v) end
    end
    local function isPress(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
    end
    hit.InputBegan:Connect(function(i) if isPress(i) then dragging = true set(i.Position.X) end end)
    track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            set(i.Position.X)
        end
    end))
    track(UIS.InputEnded:Connect(function(i) if isPress(i) then dragging = false end end))
end

local function button(parent, text, order, callback)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = T.bg, BorderSizePixel = 0,
        AutoButtonColor = false, Text = text, TextColor3 = T.text, TextSize = 12,
        Font = Enum.Font.GothamMedium, LayoutOrder = order,
    }, parent)
    corner(b, 7); stroke(b)
    b.MouseEnter:Connect(function() tween(b, { TextColor3 = T.on }, 0.15) end)
    b.MouseLeave:Connect(function() tween(b, { TextColor3 = T.text }, 0.15) end)
    b.MouseButton1Click:Connect(function() if callback then callback() end end)
    return b
end

